  textPanelOnHand: {fileID: 2033570219}
  handMenuRequester: {fileID: 923911995}
  errorLog: {fileID: 1957653098}
  errorCooldownSeconds: 3
  aliasMap: {fileID: 0}
  customErrorMessages:
  - interactedObjectName: Fuoco
    customMessage: Ti sei avvicinato troppo al fuoco e ti sei bruciato, come Icaro.
    weight: 1
  - interactedObjectName: QuizManager
    customMessage: "La risposta selezionata era sbagliata. \nPensavo che almeno sapessi
      leggere."
    weight: 1
  - interactedObjectName: Mappa Vie Di Fuga
    customMessage: "L'uscita selezionata non era la pi\xF9 vicina. Parlerai tu con
      i genitori della bambina."
    weight: 1
  - interactedObjectName: liquid_collider
    customMessage: Hai fatto schizzare il liquido diffondendo le fiamme. Sai solo
      peggiorare le cose.
    weight: 1
  - interactedObjectName: SpawnArea
    customMessage: "Hai respirato troppo fumo. \nAvevi promesso che avresti smesso."
    weight: 1
  - interactedObjectName: ReportManager
    customMessage: "Hai commesso un errore nella segnalazione. \nTutti possono sbagliare,
      ma figlio mio, tu te ne approfitti."
    weight: 1
  - interactedObjectName: Extinguisher_Water
    customMessage: Per iniziare l'erogazione devi prima togliere la sicura. Non continuare
      a premere a caso, grazie.
    weight: 1
  - interactedObjectName: Extinguisher_CO2
    customMessage: Per iniziare l'erogazione devi prima togliere la sicura. Non continuare
      a premere a caso, grazie.
    weight: 1
  - interactedObjectName: Extinguisher_Foam
    customMessage: Per iniziare l'erogazione devi prima togliere la sicura. Non continuare
      a premere a caso, grazie.
    weight: 1
  - interactedObjectName: ChapterTimer
    customMessage: '<b>TEMPO SCADUTO<b>: non abbiamo tutto il giorno. <b>Passa allo
      step successivo<b>.'
    weight: 1
  - interactedObjectName: Michelle_uscita
    customMessage: "L'uscita che hai scelto non era la pi\xF9 vicina, avresti potuto
      rispariarmiare 1,4 secondi."
    weight: 1
  - interactedObjectName: Timmy_uscita
    customMessage: "L'uscita che hai scelto non era la pi\xF9 vicina, avresti potuto
      rispariarmiare 1,4 secondi."
    weight: 1
  - interactedObjectName: Jackie_uscita
    customMessage: "L'uscita che hai scelto non era la pi\xF9 vicina, controlla megio
      la mappa la prossima volta"
    weight: 1
  - interactedObjectName: markus_uscita
    customMessage: "L'uscita che hai scelto non era la pi\xF9 vicina, avresti potuto
      rispariarmiare 1,4 secondi."
    weight: 1
  - interactedObjectName: Wrong extinguisher
    customMessage: "Per questo tipo di fuoco serve un altro estintore. Questo non
      \xE8 adatto, come te."
    weight: 1
  - interactedObjectName: Garza_Sporca
    customMessage: Vuoi pure sputarci sopra? Non puoi usare una garza caduta per
      terra, infetterai la ferita.
    weight: 1
  - interactedObjectName: VerificaPorte
    customMessage: Hai lasciato qualche porta aperta, che disdetta.
    weight: 1
  - interactedObjectName: Bambino_tempoScaduto
    customMessage: Non siamo in gita scolastica. Porta fuori quel bambino.
    weight: 1
  customErrorMessagesRuntime:
  - interactedObjectName: Aula
    customMessage: Finisci di perlustrare un aula prima di passare alla successiva.
      Porta fuori i bambini e chiudi la porta. Torna a _ e finisci quello che hai
      iniziato.
    weight: 1
  - interactedObjectName: Bambino
    customMessage: Finisci di perlustrare un aula prima di passare alla successiva.
      Porta fuori i bambini e chiudi la porta. Torna a _ e finisci quello che hai
      iniziato.
    weight: 1
  - interactedObjectName: Porta
    customMessage: Finisci di perlustrare un aula prima di passare alla successiva.
      Porta fuori i bambini e chiudi la porta. Torna a _ e finisci quello che hai
      iniziato.
    weight: 1
  customErrorMessagesToChapters:
  - chapterName: "Interruzione elettricit\xE0+gas"
    customErrorMessages:
    - interactedObjectName: LeverEmpty
      customMessage: 'Tira la leva Kronk! L''ALTRA LEVAAAA!


        Usa solo gli
        inetrruttori che hai visto nell''ufficio.'
      weight: 1
    - interactedObjectName: Button Visuals
      customMessage: 'Complimenti, premendo questo bottone hai fatto saltare in aira
        Busto Arsizio.


        Usa solo gli inetrruttori che hai visto nell''ufficio.'
      weight: 1
    - interactedObjectName: Dial Visuals
      customMessage: "C'\xE8 un tempo e un luogo per ogni cosa, ma non ora. \n\nUsa
        solo gli inetrruttori che hai visto nell'ufficio."
      weight: 1
    - interactedObjectName: Wheel
      customMessage: 'Non stai giocando a Mario Kart, gira la mapola giusta.


        Usa
        solo gli inetrruttori che hai visto nell''ufficio.'
      weight: 1
