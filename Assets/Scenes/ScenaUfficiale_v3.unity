    - target: {fileID: 4054075968104988527, guid: 45c500a3433090b41bfe6ad005d270cf, type: 3}
      propertyPath: m_text
      value: "Addio, addio, amici a addio, noi ci dobbiamo lasciare!\n\nQuesta iterazione
        \xE8 giunta alla fine, ma non temere ne hai molte altre davanti.\n\nPremi
        il pulsante per tornare al men\xF9 e ripetere questa magica esperienza. Paolina
        ti aspetta!\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4238002141373961391, guid: 45c500a3433090b41bfe6ad005d270cf, type: 3}
      propertyPath: m_text
      value: "Torna al men\xF9\n"
      objectReference: {fileID: 0}
